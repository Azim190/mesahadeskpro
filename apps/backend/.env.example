# Server Port
PORT=3000

# Central Database Connection URL
# Choose ONE of the following options:

# Option 1: Free Cloud PostgreSQL on Neon.tech (Recommended - Instant & Works everywhere)
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Free Cloud PostgreSQL on Supabase
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.xyz.supabase.co:5432/postgres?sslmode=require

# Option 3: Local / LAN PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/masahadesk?schema=public

# Option 4: Leave blank or unset to use local SQLite database fallback (data/masaha_backend.db)
# DATABASE_URL=

# SSL Configuration for Cloud PostgreSQL (set to true or false)
DATABASE_SSL=true

# Authentication Secret
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# Optional Redis Cache (falls back to memory if unset)
# REDIS_URL=redis://localhost:6379

# SMTP / Email for OTP notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=maxpro190@gmail.com
SMTP_PASS=
SMTP_FROM="MasahaDesk Security" <maxpro190@gmail.com>
OTP_EMAIL_TO=maxpro190@gmail.com
